# As ferramentas que compilam este projeto — Vite, TypeScript, os plugins do
# React e do Tailwind, e os @types — são devDependencies. Plataformas de deploy
# (Render, Heroku e afins) rodam o build com NODE_ENV=production, e nesse modo o
# npm pula devDependencies: o build então falha com "Cannot find module 'vite'".
#
# `include=dev` restaura a instalação completa em qualquer plataforma, sem
# depender de o comando de build carregar a flag certa.
include=dev
