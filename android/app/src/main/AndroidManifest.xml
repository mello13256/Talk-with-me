<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 13 e acima exigem que o usuário autorize notificações. Sem esta
      permissão declarada, o sistema nunca chega a perguntar e as notificações
      simplesmente não aparecem.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- O app é uma casca sobre o site; não faz sentido sem rede. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="${launcherName}"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">

        <!-- Metade da prova de propriedade do domínio; a outra metade é o
             /.well-known/assetlinks.json servido pelo site. -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:label="${launcherName}">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="${defaultUrl}" />

            <!-- Barras do sistema na cor da marca, para o app não emendar numa
                 faixa branca de navegador. -->
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/brand" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/brand" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Faz os links do próprio site abrirem no app em vez do
                 navegador, uma vez verificado o assetlinks. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${hostName}" />
            </intent-filter>
        </activity>

        <!--
          O que faz a notificação parecer a de um aplicativo de verdade.
          Sem este serviço, um aviso de mensagem nova chega creditado ao Chrome,
          com o ícone do Chrome. Com ele, o Chrome delega a exibição ao app: a
          notificação aparece com o nome e o ícone do canal, como as de um
          mensageiro comum.
        -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
