# =============================================================================
# Talk with me — configuração de ambiente
#
# Copie este arquivo para `.env` (na raiz do projeto) e preencha os valores.
# NUNCA versione o `.env` — ele contém segredos.
#
# Gere os segredos com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# URL pública do frontend. Usada nos links de recuperação de senha e nas
# notificações push. Em produção use o domínio real, com https.
APP_URL=http://localhost:5173
# Número de proxies confiáveis à frente do app (Render/Railway/Fly = 1).
# Necessário para que o IP real chegue ao rate limiting e ao log de auditoria.
TRUST_PROXY=0
LOG_LEVEL=info

# --- VM própria (docker-compose.prod.yml) ------------------------------------
# Usados apenas pela stack completa com Docker. Ignore se for hospedar em
# Render/Fly/Railway, onde DATABASE_URL e o HTTPS vêm do provedor.
DOMAIN=atendimento.seudominio.com
ACME_EMAIL=voce@seudominio.com
POSTGRES_USER=talkwithme
POSTGRES_PASSWORD=
POSTGRES_DB=talkwithme

# --- Banco de dados ----------------------------------------------------------
DATABASE_URL=postgresql://talkwithme:talkwithme@localhost:5432/talkwithme
# Ative em provedores gerenciados (Neon, Supabase, Railway, Render).
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Segurança ---------------------------------------------------------------
# Chave usada para derivar o hash dos tokens de sessão e de recuperação.
# Trocá-la desconecta todo mundo. Mínimo de 32 caracteres.
SESSION_SECRET=troque-isto-por-uma-chave-aleatoria-de-32-caracteres
# "Pepper" misturado a toda senha antes do bcrypt.
# ATENÇÃO: trocar este valor invalida TODAS as senhas existentes.
PASSWORD_PEPPER=troque-isto-por-outro-segredo-aleatorio
SESSION_COOKIE_NAME=twm_session
SESSION_TTL_DAYS=30
BCRYPT_COST=12
# Deixe vazio quando a API e o frontend estiverem no mesmo domínio (recomendado).
# Ex.: https://app.seudominio.com,https://www.seudominio.com
CORS_ORIGINS=
# Defina false para deixar o cadastro apenas por convite do administrador.
ALLOW_PUBLIC_REGISTRATION=true

# --- Armazenamento de arquivos ----------------------------------------------
# local = disco do servidor (bom para desenvolvimento e VPS com disco persistente)
# s3    = qualquer bucket compatível com S3 (Cloudflare R2, Backblaze B2, AWS S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=25
# Teto acumulado de anexos por cliente (impede um cliente de encher o disco).
# O administrador é isento.
MAX_STORAGE_PER_CLIENT_MB=500

# Preencha somente quando STORAGE_DRIVER=s3. O bucket deve ser PRIVADO:
# os downloads sempre passam pela API, que verifica a permissão.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Primeiro acesso do administrador ----------------------------------------
# Cria a conta de administrador na inicialização, e SOMENTE se ainda não existir
# nenhum administrador no banco. Serve para hospedagens sem acesso a terminal.
# Depois de entrar, REMOVA ADMIN_PASSWORD e troque a senha dentro do app.
# Alternativa pelo terminal: npm run seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# --- E-mail (recuperação de senha) ------------------------------------------
# console = apenas imprime o link no log (somente desenvolvimento)
# smtp    = qualquer servidor SMTP
# resend  = API da Resend (https://resend.com)
MAIL_DRIVER=console
# Permite MAIL_DRIVER=console em produção (só para o primeiro deploy).
# Com isso, os links de recuperação de senha ficam apenas no log do servidor —
# seus clientes NÃO conseguem recuperar a senha sozinhos. Configure smtp/resend.
ALLOW_INSECURE_MAIL=false
MAIL_FROM=Talk with me <no-reply@seudominio.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# --- Notificações push do navegador (opcional) -------------------------------
# Gere o par de chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@seudominio.com

# --- Frontend (build) --------------------------------------------------------
# Só é necessário quando o frontend for hospedado em um domínio diferente da API.
# Vazio = mesma origem (recomendado).
VITE_API_URL=
